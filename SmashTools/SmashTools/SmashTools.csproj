<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Authors>Smash Phil</Authors>
		<Description>Developer tool SDK for RimWorld mods. Primarily used by Vehicle Framework.</Description>
		<Product>SmashTools</Product>
    <RootNamespace>SmashTools</RootNamespace>
    <AssemblyName>SmashTools</AssemblyName>
    <ProjectGuid>{B6B2FD58-D7EC-482A-927D-EBB012A468A8}</ProjectGuid>

    <ModDir>..\..\..\</ModDir>
		<OutDir>$(ModDir)\1.6\Assemblies\</OutDir>
	</PropertyGroup>

	<!-- AssemblyInfo -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>Test_SmashTools</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- Dependencies -->
	<ItemGroup Condition="'$(UseLocalBurstLib)' != 'true'">
		<PackageReference Include="SmashTools.Burst" Version="1.2.3" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseLocalBurstLib)' == 'true'">
		<Reference Include="SmashToolsBurst">
			<HintPath>$(OutDir)\SmashToolsBurst.dll</HintPath>
