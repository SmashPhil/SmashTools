<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Authors>Smash Phil</Authors>
		<Description>Developer tool SDK for RimWorld mods. Primarily used by Vehicle Framework.</Description>
		<Product>SmashTools - Core</Product>
		<FileVersion>1.6.0</FileVersion>
		<AssemblyVersion>1.6.0</AssemblyVersion>

		<Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
		<Configurations>Debug;Unstable;Release;ReleaseTesting</Configurations>
		<Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
		<ProjectGuid>{B6B2FD58-D7EC-482A-927D-EBB012A468A8}</ProjectGuid>
		<OutputType>Library</OutputType>
		<AppDesignerFolder>Properties</AppDesignerFolder>
		<RootNamespace>CoreLib</RootNamespace>
		<AssemblyName>CoreLib</AssemblyName>
		<TargetFramework>net48</TargetFramework>
		<FileAlignment>512</FileAlignment>
		<Deterministic>true</Deterministic>
		<LangVersion>preview</LangVersion>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ModDir>..\..\</ModDir>
		<OutDir>$(ModDir)\1.6\Assemblies\</OutDir>
		<RefDir>$(ModDir)\..\..\RimWorldWin64_Data\Managed\</RefDir>
		<LangVersion>preview</LangVersion>
		<DebugType>embedded</DebugType>
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>CS0649</NoWarn>
	</PropertyGroup>

	<!-- AssemblyInfo -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>SmashTools</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>Test_SmashTools</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>Test_CoreLib</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- Build Events -->
	<Target Name="PostClean" AfterTargets="Clean">
		<RemoveDir Directories="$(OutDir)" />
	</Target>

	<!-- Configurations -->
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<DebugSymbols>true</DebugSymbols>
		<Optimize>false</Optimize>
		<DefineConstants>TRACE;DEBUG;UNITY_ASSERTIONS;DEV_TOOLS;PROFILER;</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Unstable|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE;UNSTABLE;UNITY_ASSERTIONS;DEV_TOOLS;</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<DebugSymbols>true</DebugSymbols>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE;RELEASE;</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'ReleaseTesting|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE;RELEASE;UNITY_ASSERTIONS;DEV_TOOLS;PROFILER;</DefineConstants>
	</PropertyGroup>

	<!-- Dependencies -->
	<ItemGroup>
		<PackageReference Include="PolySharp" Version="1.*" />
	</ItemGroup>
	
	<ItemGroup Condition="!Exists('$(RefDir)')">
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
	</ItemGroup>
	<ItemGroup Condition="Exists('$(RefDir)')">
		<Reference Include="System">
			<HintPath>$(RefDir)\System.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="System.Xml">
			<HintPath>$(RefDir)\System.Xml.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="System.Xml.Linq">
			<HintPath>$(RefDir)\System.Xml.Linq.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="System">
			<HintPath>$(RefDir)\mscorlib.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(RefDir)\UnityEngine.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(RefDir)\UnityEngine.CoreModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.IMGUIModule">
			<HintPath>$(RefDir)\UnityEngine.IMGUIModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(RefDir)\UnityEngine.InputLegacyModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.InputModule">
			<HintPath>$(RefDir)\UnityEngine.InputModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.TextRenderingModule">
			<HintPath>$(RefDir)\UnityEngine.TextRenderingModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<Folder Include="Algorithms\" />
		<Folder Include="Extensions\" />
		<Folder Include="Properties\" />
	</ItemGroup>
</Project>