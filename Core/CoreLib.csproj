<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Authors>Smash Phil</Authors>
		<Description>Developer tool SDK for RimWorld mods. Primarily used by Vehicle Framework.</Description>
		<Product>CoreLib</Product>
    <RootNamespace>CoreLib</RootNamespace>
    <AssemblyName>CoreLib</AssemblyName>
    <OutDir>$(ModDir)\1.7\Assemblies\</OutDir>
	</PropertyGroup>

	<!-- AssemblyInfo -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>SmashTools</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>Test_SmashTools</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>Test_CoreLib</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- Build Events -->
	<Target Name="PostClean" AfterTargets="Clean">
		<RemoveDir Directories="$(OutDir)" />
	</Target>

	<ItemGroup>
    <Reference Include="Brutal.Glfw">
      <HintPath>$(RefDir)\Brutal.Glfw.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Brutal.ImGui">
      <HintPath>$(RefDir)\Brutal.ImGui.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Brutal.Core.Common">
      <HintPath>$(RefDir)\Brutal.Core.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Brutal.Core.Numerics">
      <HintPath>$(RefDir)\Brutal.Core.Numerics.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Brutal.Vulkan">
      <HintPath>$(RefDir)\Brutal.Vulkan.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Brutal.Vulkan.Abstractions">
      <HintPath>$(RefDir)\Brutal.Vulkan.Abstractions.dll</HintPath>
      <Private>False</Private>
    </Reference>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Algorithms\" />
	</ItemGroup>
</Project>
